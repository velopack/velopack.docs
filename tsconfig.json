{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TS 7 removed `baseUrl` (TS5102), but @docusaurus/tsconfig still ships it (facebook/docusaurus#11893).
    // Unset it, and redeclare `paths` here so they resolve relative to this file rather than the base config.
    // Remove once we upgrade to the Docusaurus release that drops baseUrl (PR #11915).
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"]
    }
  }
}
